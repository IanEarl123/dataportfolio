# Copy this file to .env.local and fill in the values from
# Supabase Dashboard -> Project Settings -> API (Data API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon public" key (or the newer "publishable" key, sb_publishable_...).
# NEVER put the service_role / secret key in a VITE_ variable — it would be shipped to browsers.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
