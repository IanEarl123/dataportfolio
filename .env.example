# Copy this file to .env.local and fill in the values from
# Supabase Dashboard -> Project Settings -> API (Data API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon public" key (or the newer "publishable" key, sb_publishable_...).
# NEVER put the service_role / secret key in a VITE_ variable — it would be shipped to browsers.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# ---- Server-only (used by the /api functions for verified comments) ----
# No VITE_ prefix: these never reach the browser. In production set them in
# Vercel -> Project -> Settings -> Environment Variables.
# Supabase Dashboard -> Project Settings -> API Keys -> "secret" (or legacy "service_role") key
SUPABASE_SERVICE_ROLE_KEY=
# Brevo -> Settings -> SMTP & API -> API Keys
BREVO_API_KEY=
# An address verified in Brevo -> Senders, Domains & Dedicated IPs -> Senders
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Ian.Analyst
# Where "new comment" alerts go (defaults to ianearlbesanez@gmail.com)
ADMIN_NOTIFY_EMAIL=
# Your live site address, used for links in the alert emails
PUBLIC_SITE_URL=
